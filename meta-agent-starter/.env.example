# meta-agent — Beispiel-Konfiguration
# Kopiere diese Datei zu ".env" und trage echte Werte ein.
# WICHTIG: .env NIEMALS committen (in .gitignore aufnehmen). Hier nur Platzhalter.

# --- Meta / Graph API ---
META_APP_ID=your_app_id
META_APP_SECRET=your_app_secret
META_ACCESS_TOKEN=your_long_lived_token
IG_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id
FB_PAGE_ID=your_facebook_page_id
META_GRAPH_API_VERSION=v20.0

# --- AI ---
ANTHROPIC_API_KEY=your_anthropic_key

# --- Datenbank ---
DATABASE_URL=sqlite:///meta_agent.db
# Produktion: postgresql://user:password@host:5432/meta_agent

# --- Scheduling ---
TIMEZONE=Europe/Zurich
POSTING_INTERVAL_HOURS=4

# --- Sicherheits-/Betriebs-Flags ---
HUMAN_APPROVAL_REQUIRED=true
AUTO_PUBLISH_ENABLED=false
QUALITY_SCORE_MIN=70

# --- Attribution ---
UTM_SOURCE_DEFAULT=meta
TRACKING_BASE_URL=https://your-domain.example
